{
  "name": "@vescofire/peersync",
  "version": "0.1.0",
  "type": "module",
  "description": "Pluggable P2P sync engine with channel-based state synchronization",
  "license": "MIT",
  "author": "Vincent Escoffier",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./peerjs": {
      "types": "./dist/transport/index.d.ts",
      "import": "./dist/transport/index.js",
      "require": "./dist/transport/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.cjs"
    }
  },
  "main": "./dist/core/index.cjs",
  "module": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest",
    "test:ci": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "peerjs": "^1.5.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "peerjs": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.7",
    "peerjs": "^1.5.4",
    "react": "^19.0.0",
    "rollup-preserve-directives": "^1.1.3",
    "typescript": "~5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^3.0.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/reifocS/peersync.git",
    "directory": "packages/peersync"
  },
  "homepage": "https://github.com/reifocS/peersync#readme",
  "bugs": {
    "url": "https://github.com/reifocS/peersync/issues"
  },
  "keywords": [
    "p2p",
    "peer-to-peer",
    "sync",
    "webrtc",
    "peerjs",
    "real-time",
    "state-sync",
    "crdt"
  ]
}
